programa
{
    funcao inicio()
    {
        cadeia nome, cidade
        inteiro idade

        escreva("Digite seu nome: ")
        leia(nome)

        escreva("Digite sua idade: ")
        leia(idade)

        escreva("Digite sua cidade: ")
        leia(cidade)

        escreva("Meu nome e ", nome, ", tenho ", idade, " anos e moro em ", cidade, ".")
    }
}