programa
{
    funcao inicio()
    {
        logico a, b, c, resultado

        escreva("Digite o valor de A (verdadeiro ou falso): ")
        leia(a)

        escreva("Digite o valor de B (verdadeiro ou falso): ")
        leia(b)

        escreva("Digite o valor de C (verdadeiro ou falso): ")
        leia(c)

        resultado = (a e b) ou c

        escreva("Resultado de (A E B) OU C = ", resultado)
    }
}